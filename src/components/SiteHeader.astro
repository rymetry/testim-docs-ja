---
import { SITE } from '../lib/site';

type Props = {
  sticky?: boolean;
};

const { sticky = false } = Astro.props;
const hasExtra = Astro.slots.has('default');
---

<header
  class:list={[
    'border-b border-slate-200',
    sticky
      ? 'sticky top-0 z-50 bg-white/95 shadow-sm backdrop-blur'
      : 'bg-white',
  ]}
>
  <div
    class:list={[
      'mx-auto flex w-full max-w-screen-2xl px-4 py-4 sm:px-6',
      hasExtra
        ? 'flex-col items-stretch gap-3 sm:flex-row sm:items-start sm:justify-between'
        : 'items-center justify-between',
    ]}
  >
    <a
      href="/"
      class:list={['flex items-center gap-2.5', hasExtra && 'w-full sm:w-auto']}
    >
      <img src={SITE.logo} alt="Testim Docs JA" class="h-8 w-8 shrink-0" />
      <p class="text-sm font-semibold tracking-wide text-slate-800">
        {SITE.title}
      </p>
    </a>
    {hasExtra && <slot />}
  </div>
</header>
