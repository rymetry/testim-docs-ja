---
import type { NavItem } from '../../types/navigation';

type Props = {
  sections: NavItem[];
  currentSlug: string;
};

const { sections, currentSlug } = Astro.props as Props;
---

<nav aria-label="ドキュメントナビゲーション" class="space-y-8">
  {
    sections.map((section) => (
      <section>
        <h2 class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-700">
          {section.label}
        </h2>
        <ul class="mt-3 space-y-1.5">
          {section.items.map((item) => {
            const isActive = currentSlug === item.slug;
            return (
              <li>
                <a
                  href={`/docs/${item.slug}`}
                  class={`block rounded-lg px-3 py-2 text-sm transition hover:bg-blue-50 hover:text-blue-600 ${
                    isActive
                      ? 'bg-blue-50 font-semibold text-blue-600'
                      : 'text-slate-600'
                  }`}
                  aria-current={isActive ? 'page' : undefined}
                >
                  {item.title}
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    ))
  }
</nav>
