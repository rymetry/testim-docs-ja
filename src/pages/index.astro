---
import HomeLayout from '../layouts/HomeLayout.astro';

const title = 'Tricentis Testim 日本語翻訳ドキュメント';
const description =
  'Tricentis Testim のヘルプドキュメントをコミュニティが日本語に翻訳したサイトです';
---

<HomeLayout title={title} description={description}>
  <!-- Hero Section -->
  <section
    class="bg-linear-to-br from-blue-600 via-blue-500 to-sky-400 px-4 py-16 text-center sm:py-24"
  >
    <div class="mx-auto max-w-3xl">
      <img src="/logo.svg" alt="" class="mx-auto h-16 w-16" aria-hidden="true" />
      <h1 class="mt-6 text-4xl font-bold text-white sm:text-5xl">
        Tricentis Testim<br />日本語翻訳ドキュメント
      </h1>
      <p class="mt-4 text-lg text-blue-100">
        Tricentis Testim のヘルプドキュメントをコミュニティが日本語に翻訳したサイトです
      </p>
      <div class="mt-8">
        <a
          href="/docs/testim-overview"
          class="inline-flex items-center gap-2 rounded-full bg-white px-6 py-3 font-semibold text-blue-600 shadow-sm transition hover:-translate-y-0.5 hover:shadow-lg"
        >
          ドキュメントへ
          <svg
            class="h-4 w-4"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Navigation Cards Section -->
  <section class="px-4 py-16 sm:px-6">
    <div class="mx-auto grid max-w-4xl grid-cols-1 gap-6 sm:grid-cols-2">
      <!-- ドキュメント -->
      <a
        href="/docs/testim-overview"
        class="group rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:shadow-md"
      >
        <div class="text-blue-600">
          <svg
            class="h-8 w-8"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path
              d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
            ></path>
          </svg>
        </div>
        <h2 class="mt-4 text-lg font-semibold text-slate-900 group-hover:text-blue-600">
          ドキュメントを読む
        </h2>
        <p class="mt-1 text-sm text-slate-500">全 284 ページの日本語翻訳ドキュメント</p>
      </a>

      <!-- Tips（準備中） -->
      <div class="rounded-2xl border border-slate-200 bg-white p-6 opacity-60 shadow-sm">
        <div class="flex items-start justify-between">
          <div class="text-slate-400">
            <svg
              class="h-8 w-8"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"
              ></path>
            </svg>
          </div>
          <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-500">準備中</span>
        </div>
        <h2 class="mt-4 text-lg font-semibold text-slate-900">Tips</h2>
        <p class="mt-1 text-sm text-slate-500">実践的なヒントやテクニック集</p>
      </div>

      <!-- Tricentis ステータス -->
      <a
        href="https://status.tricentis.com/"
        target="_blank"
        rel="noopener noreferrer"
        class="group rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:shadow-md"
      >
        <div class="text-blue-600">
          <svg
            class="h-8 w-8"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M18.364 5.636a9 9 0 010 12.728M15.536 8.464a5 5 0 010 7.072M12 12h.01"></path>
          </svg>
        </div>
        <div class="mt-4 flex items-center gap-1.5">
          <h2 class="text-lg font-semibold text-slate-900 group-hover:text-blue-600">
            Tricentis ステータス
          </h2>
          <svg
            class="h-4 w-4 text-slate-400"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
            ></path>
          </svg>
        </div>
        <p class="mt-1 text-sm text-slate-500">Tricentis サービスの稼働状況を確認</p>
      </a>

      <!-- GitHub -->
      <a
        href="https://github.com/rymetry/testim-docs-ja"
        target="_blank"
        rel="noopener noreferrer"
        class="group rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:shadow-md"
      >
        <div class="text-blue-600">
          <svg class="h-8 w-8" viewBox="0 0 24 24" fill="currentColor">
            <path
              fill-rule="evenodd"
              clip-rule="evenodd"
              d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
            ></path>
          </svg>
        </div>
        <div class="mt-4 flex items-center gap-1.5">
          <h2 class="text-lg font-semibold text-slate-900 group-hover:text-blue-600">
            GitHub リポジトリ
          </h2>
          <svg
            class="h-4 w-4 text-slate-400"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
            ></path>
          </svg>
        </div>
        <p class="mt-1 text-sm text-slate-500">ソースコード・翻訳への貢献</p>
      </a>
    </div>
  </section>

  <!-- About Section -->
  <section class="bg-white px-4 py-16 sm:px-6">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-2xl font-semibold text-slate-900">このサイトについて</h2>
      <p class="mt-4 text-slate-600">
        Tricentis Testim
        の公式英語ドキュメントを、コミュニティが日本語に翻訳したサイトです。テスト自動化に取り組む日本語ユーザーの皆さんが、より快適にドキュメントを活用できることを目指しています。
      </p>
      <div
        class="mt-8 inline-flex items-center gap-2 rounded-full bg-blue-50 px-4 py-2 text-sm font-medium text-blue-700"
      >
        <svg
          class="h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path
            d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
          ></path>
        </svg>
        284 ページ翻訳済み
      </div>
    </div>
  </section>
</HomeLayout>
