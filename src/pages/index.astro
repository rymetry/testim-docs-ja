---
import DocsLayout from '../layouts/DocsLayout.astro';
import { buildNavigation, getDocs } from '../lib/docs';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('docs', 'overview/testim-overview');

if (!entry) {
  return Astro.redirect('/404');
}

const [rendered, docs] = await Promise.all([render(entry), getDocs()]);

const navSections = buildNavigation(docs);
const { Content, headings } = rendered;

const { title, description, hero } = entry.data;
---

<DocsLayout
  title={title}
  description={description}
  hero={hero}
  navSections={navSections}
  currentSlug="testim-overview"
  headings={headings}
>
  <Content />
</DocsLayout>
