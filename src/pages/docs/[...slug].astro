---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { buildNavigation, getDocs, extractSlug } from '../../lib/docs';
import { getEntry, render } from 'astro:content';

// Static生成用: output='static'の時のみ実行される
export async function getStaticPaths() {
  const docs = await getDocs();
  return docs.map((doc) => {
    return {
      params: { slug: extractSlug(doc) },
      props: { docId: doc.id },
    };
  });
}

const slugParam = Astro.params.slug ?? 'overview/testim-overview';
const docs = await getDocs();

// SSRモード: URLパラメータからdocIdを解決（doc.id はパスベース slug と同一）
// Staticモード: propsからdocIdを取得
const docId =
  Astro.props?.docId ??
  (() => {
    const match = docs.find((doc) => doc.id === slugParam);
    return match?.id;
  })();

if (!docId) {
  return Astro.redirect('/404');
}

const entry = await getEntry('docs', docId);

if (!entry) {
  return Astro.redirect('/404');
}

const rendered = await render(entry);

const navSections = buildNavigation(docs);
const { Content, headings } = rendered;

const slug = slugParam;
const { title, description, hero, sourceUrl } = entry.data;
---

<DocsLayout
  title={title}
  description={description}
  hero={hero}
  navSections={navSections}
  currentSlug={slug}
  headings={headings}
  sourceUrl={sourceUrl}
>
  <Content />
</DocsLayout>
