---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { buildNavigation, getDocs, extractSlug } from '../../lib/docs';
import { getEntry } from 'astro:content';

// Static生成用: output='static'の時のみ実行される
export async function getStaticPaths() {
  const docs = await getDocs();
  return docs.map((doc) => {
    return {
      params: { slug: extractSlug(doc) },
      props: { docId: doc.id },
    };
  });
}

const slugParam = Astro.params.slug ?? 'testim-overview';
const docs = await getDocs();

// SSRモード: URLパラメータからdocIdを解決
// Staticモード: propsからdocIdを取得
const docId = Astro.props?.docId ?? (() => {
  const match = docs.find((doc) => extractSlug(doc) === slugParam);
  return match?.id;
})();

if (!docId) {
  return Astro.redirect('/404');
}

// docIdから.mdを除いたものを使用
const entry = await getEntry('docs', docId.replace(/\.md$/, ''));

if (!entry) {
  return Astro.redirect('/404');
}

const rendered = await entry.render();

const navSections = buildNavigation(docs);
const { Content, headings } = rendered;

const slug = slugParam;
const { title, description, hero } = entry.data;
---

<DocsLayout
  title={title}
  description={description}
  hero={hero}
  navSections={navSections}
  currentSlug={slug}
  headings={headings}
>
  <Content />
</DocsLayout>
