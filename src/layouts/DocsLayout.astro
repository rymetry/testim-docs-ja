---
import '../styles/global.css';

import type { MarkdownHeading } from 'astro';
import NavSidebar from '../components/navigation/NavSidebar.astro';
import TableOfContents from '../components/TableOfContents.astro';
import SearchModal from '../components/SearchModal';
import type { NavItem } from '../types/navigation';

type DocsLayoutProps = {
  title: string;
  description: string;
  hero?: {
    eyebrow?: string;
    title: string;
    subtitle: string;
    primaryCta?: { label: string; href: string };
    secondaryCta?: { label: string; href: string };
  };
  navSections: NavItem[];
  currentSlug: string;
  headings: MarkdownHeading[];
};

const { title, description, hero, navSections, currentSlug, headings } =
  Astro.props as DocsLayoutProps;
---

<html lang="ja" class="h-full bg-slate-50">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Tricentis Testim ユーザー制作日本語翻訳ドキュメント</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="flex min-h-screen flex-col font-sans text-slate-900 antialiased">
    <header class="sticky top-0 z-50 border-b border-slate-200 bg-white/95 shadow-sm backdrop-blur">
      <div class="mx-auto flex w-full max-w-screen-2xl flex-col items-stretch gap-3 px-4 py-4 sm:flex-row sm:items-start sm:justify-between sm:px-6">
        <a href="/" class="flex w-full items-center gap-3 sm:w-auto">
          <img src="/logo.svg" alt="Testim Docs Logo" class="h-9 w-9 rounded-xl shadow-inner" />
          <p class="text-sm font-semibold tracking-wide text-slate-800">
            Tricentis Testim ユーザー制作日本語翻訳ドキュメント
          </p>
        </a>
        <div class="flex w-full flex-col gap-2 sm:w-auto sm:min-w-[280px]">
          <SearchModal client:load />
          <div class="lg:hidden" id="mobile-doc-nav-container">
            <div class="relative">
              <select
                id="mobile-doc-nav"
                aria-label="カテゴリナビゲーション"
                class="w-full appearance-none rounded-xl border-2 border-slate-200 bg-white px-4 py-3 text-sm font-medium text-slate-700 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-200"
                onchange="if (this.value) window.location.href=this.value"
              >
                {
                  navSections.map((section) => (
                    <optgroup label={section.label}>
                      {
                        section.items.map((item) => (
                          <option value={`/docs/${item.slug}`} selected={item.slug === currentSlug}>
                            {item.title}
                          </option>
                        ))
                      }
                    </optgroup>
                  ))
                }
              </select>
              <svg
                class="pointer-events-none absolute right-4 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </div>
          </div>
        </div>
      </div>
    </header>

    <div class="mx-auto flex w-full max-w-screen-2xl flex-1 gap-8 px-4 py-10 sm:px-6 lg:gap-12">
      <aside class="hidden w-64 shrink-0 lg:block">
        <div id="doc-sidebar-scroll" class="sticky top-30 max-h-[calc(100vh-7rem)] overflow-y-auto pr-2">
          <NavSidebar sections={navSections} currentSlug={currentSlug} />
        </div>
      </aside>

      <main class="flex-1 min-w-0">
        {
          hero ? (
            <section class="rounded-3xl bg-linear-to-br from-blue-600 via-blue-500 to-sky-400 p-8 text-white shadow-lg">
              <p class="text-xs uppercase tracking-[0.4em] text-blue-100">{hero.eyebrow}</p>
              <h1 class="mt-3 text-3xl font-semibold leading-tight">{hero.title}</h1>
              <p class="mt-4 max-w-2xl text-base text-blue-50">{hero.subtitle}</p>
              <div class="mt-6 flex flex-wrap gap-3 text-sm">
                {hero.primaryCta && (
                  <a
                    href={hero.primaryCta.href}
                    class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 font-semibold text-blue-600 shadow-sm transition hover:-translate-y-0.5 hover:shadow-lg"
                  >
                    {hero.primaryCta.label}
                  </a>
                )}
                {hero.secondaryCta && (
                  <a
                    href={hero.secondaryCta.href}
                    class="inline-flex items-center gap-2 rounded-full border border-white/60 px-4 py-2 font-semibold text-white transition hover:bg-white/10"
                  >
                    {hero.secondaryCta.label}
                  </a>
                )}
              </div>
            </section>
          ) : (
            <h1 class="text-3xl font-semibold">{title}</h1>
          )
        }

        <article class="docs-prose mt-10 max-w-none text-base leading-relaxed">
          <slot />
        </article>
      </main>

      <aside class="hidden w-60 shrink-0 xl:block">
        <TableOfContents headings={headings} />
      </aside>
    </div>

    <footer class="border-t border-slate-200 bg-white py-6">
      <div class="mx-auto w-full max-w-screen-2xl px-4 sm:px-6">
        <div class="flex flex-col gap-3 text-xs text-slate-500 sm:flex-row sm:items-center sm:justify-between">
          <div class="flex flex-col gap-1">
            <p class="font-medium text-slate-700">
              &copy; 2025 Tricentis Testim ユーザー制作日本語翻訳ドキュメント
            </p>
            <p class="text-slate-400">
              このサイトは <a
                href="https://help.testim.io/docs/testim-overview"
                target="_blank"
                rel="noopener noreferrer"
                class="text-blue-600 underline decoration-blue-200 hover:text-blue-700"
              >
                Tricentis Testim Docs（公式ドキュメント）
              </a> のユーザー制作日本語翻訳ドキュメントです
            </p>
          </div>
        </div>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const KEY = 'doc-sidebar-scroll';
        const getEl = () => document.getElementById('doc-sidebar-scroll');

        const restore = () => {
          const el = getEl();
          if (!el) return;
          try {
            const saved = sessionStorage.getItem(KEY);
            if (!saved) return;
            const { top } = JSON.parse(saved);
            if (typeof top === 'number') el.scrollTop = top;
          } catch {}
        };

        const save = () => {
          const el = getEl();
          if (!el) return;
          try {
            sessionStorage.setItem(KEY, JSON.stringify({ top: el.scrollTop }));
          } catch {}
        };

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', restore, { once: true });
        } else {
          restore();
        }

        window.addEventListener('beforeunload', save);
        window.addEventListener('pagehide', save);
      })();
    </script>

    <script is:inline>
      (() => {
        const isImageLink = (img) => img.closest('a');

        const backdrop = document.createElement('div');
        backdrop.className = 'image-lightbox-backdrop';

        const body = document.createElement('div');
        body.className = 'image-lightbox-body';

        const closeBtn = document.createElement('button');
        closeBtn.type = 'button';
        closeBtn.className = 'image-lightbox-close';
        closeBtn.setAttribute('aria-label', '閉じる');
        closeBtn.innerText = '×';

        const img = document.createElement('img');
        img.alt = '';
        const caption = document.createElement('div');
        caption.className = 'image-lightbox-caption';

        body.appendChild(closeBtn);
        body.appendChild(img);
        body.appendChild(caption);
        backdrop.appendChild(body);
        document.body.appendChild(backdrop);

        const hide = () => {
          backdrop.classList.remove('is-visible');
          img.src = '';
          caption.textContent = '';
        };

        const show = (src, altText) => {
          img.src = src;
          img.alt = altText || '';
          caption.textContent = altText || '';
          backdrop.classList.add('is-visible');
        };

        backdrop.addEventListener('click', (e) => {
          if (e.target === backdrop || e.target === closeBtn) {
            hide();
          }
        });

        window.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') hide();
        });

        document.addEventListener('click', (e) => {
          const target = e.target;
          if (!(target instanceof HTMLImageElement)) return;
          if (!target.closest('.docs-prose')) return;
          if (isImageLink(target)) return;

          const src = target.currentSrc || target.src;
          if (!src) return;

          e.preventDefault();
          show(src, target.alt || '');
        });
      })();
    </script>
  </body>
</html>
