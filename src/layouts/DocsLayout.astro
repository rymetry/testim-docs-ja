---
import '../styles/global.css';
import { Font } from 'astro:assets';

import type { MarkdownHeading } from 'astro';
import NavSidebar from '../components/navigation/NavSidebar.astro';
import TableOfContents from '../components/TableOfContents.astro';
import SearchModal from '../components/SearchModal';
import type { NavItem } from '../types/navigation';

type DocsLayoutProps = {
  title: string;
  description: string;
  hero?: {
    eyebrow?: string;
    title: string;
    subtitle: string;
    primaryCta?: { label: string; href: string };
    secondaryCta?: { label: string; href: string };
  };
  navSections: NavItem[];
  currentSlug: string;
  headings: MarkdownHeading[];
};

const { title, description, hero, navSections, currentSlug, headings } =
  Astro.props as DocsLayoutProps;

const siteTitle = 'Tricentis Testim ユーザー制作日本語翻訳ドキュメント';
const pageTitle = `${title} | ${siteTitle}`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const ogImageUrl = new URL('/og-image.png', Astro.site ?? Astro.url);

const GTM_ID = 'GTM-MVHF4WN9';

const gtmHeadCode = `
<!-- Google Tag Manager -->
<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','${GTM_ID}');</script>
<!-- End Google Tag Manager -->
`;

const gtmBodyCode = `
<!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=${GTM_ID}"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->
`;
---

<html lang="ja" class="h-full bg-slate-50">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl.href} />
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:image" content={ogImageUrl.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content={siteTitle} />
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl.href} />
    <Font cssVariable="--font-noto-sans-jp" preload />
    <Fragment set:html={gtmHeadCode} />
  </head>
  <body class="flex min-h-screen flex-col font-sans text-slate-900 antialiased">
    <Fragment set:html={gtmBodyCode} />
    <header class="sticky top-0 z-50 border-b border-slate-200 bg-white/95 shadow-sm backdrop-blur">
      <div
        class="mx-auto flex w-full max-w-screen-2xl flex-col items-stretch gap-3 px-4 py-4 sm:flex-row sm:items-start sm:justify-between sm:px-6"
      >
        <a href="/" class="flex w-full items-center gap-2.5 sm:w-auto">
          <img src="/logo.svg" alt="Testim Docs JA" class="h-8 w-8 shrink-0" />
          <p class="text-sm font-semibold tracking-wide text-slate-800">
            Tricentis Testim ユーザー制作日本語翻訳ドキュメント
          </p>
        </a>
        <div class="flex w-full flex-col gap-2 sm:w-auto sm:flex-row sm:items-center sm:gap-3">
          <div class="sm:min-w-[280px]">
            <SearchModal client:load />
          </div>
          <div class="hidden items-center gap-2 sm:flex">
            <a
              href="https://status.tricentis.com/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Tricentis ステータスページ（新しいタブで開く）"
              class="rounded-lg p-1.5 text-slate-500 transition hover:bg-slate-100 hover:text-slate-900"
            >
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M18.364 5.636a9 9 0 010 12.728M15.536 8.464a5 5 0 010 7.072M12 12h.01" />
              </svg>
            </a>
            <a
              href="https://github.com/rymetry/testim-docs-ja"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="GitHub リポジトリ（新しいタブで開く）"
              class="rounded-lg p-1.5 text-slate-500 transition hover:bg-slate-100 hover:text-slate-900"
            >
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
              </svg>
            </a>
          </div>
          <div class="lg:hidden" id="mobile-doc-nav-container">
            <div class="relative">
              <select
                id="mobile-doc-nav"
                aria-label="カテゴリナビゲーション"
                class="w-full appearance-none rounded-xl border-2 border-slate-200 bg-white px-4 py-3 text-sm font-medium text-slate-700 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-200"
                onchange="if (this.value) window.location.href=this.value"
              >
                {
                  navSections.map((section) => (
                    <optgroup label={section.label}>
                      {section.items.map((item) => (
                        <option value={`/docs/${item.slug}`} selected={item.slug === currentSlug}>
                          {item.title}
                        </option>
                      ))}
                    </optgroup>
                  ))
                }
              </select>
              <svg
                class="pointer-events-none absolute right-4 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 9l-7 7-7-7"></path>
              </svg>
            </div>
          </div>
        </div>
      </div>
    </header>

    <div class="mx-auto flex w-full max-w-screen-2xl flex-1 gap-8 px-4 py-10 sm:px-6 lg:gap-12">
      <aside class="hidden w-64 shrink-0 lg:block">
        <div
          id="doc-sidebar-scroll"
          class="sticky top-30 max-h-[calc(100vh-7rem)] overflow-y-auto pr-2"
        >
          <NavSidebar sections={navSections} currentSlug={currentSlug} />
        </div>
      </aside>

      <main class="flex-1 min-w-0">
        {
          hero ? (
            <section class="rounded-3xl bg-linear-to-br from-blue-600 via-blue-500 to-sky-400 p-8 text-white shadow-lg">
              <p class="text-xs uppercase tracking-[0.4em] text-blue-100">{hero.eyebrow}</p>
              <h1 class="mt-3 text-3xl font-semibold leading-tight">{hero.title}</h1>
              <p class="mt-4 max-w-2xl text-base text-blue-50">{hero.subtitle}</p>
              <div class="mt-6 flex flex-wrap gap-3 text-sm">
                {hero.primaryCta && (
                  <a
                    href={hero.primaryCta.href}
                    class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 font-semibold text-blue-600 shadow-sm transition hover:-translate-y-0.5 hover:shadow-lg"
                  >
                    {hero.primaryCta.label}
                  </a>
                )}
                {hero.secondaryCta && (
                  <a
                    href={hero.secondaryCta.href}
                    class="inline-flex items-center gap-2 rounded-full border border-white/60 px-4 py-2 font-semibold text-white transition hover:bg-white/10"
                  >
                    {hero.secondaryCta.label}
                  </a>
                )}
              </div>
            </section>
          ) : (
            <h1 class="text-3xl font-semibold">{title}</h1>
          )
        }

        <article class="docs-prose mt-10 max-w-none text-base leading-relaxed">
          <slot />
        </article>
      </main>

      <aside class="hidden w-60 shrink-0 xl:block">
        <TableOfContents headings={headings} />
      </aside>
    </div>

    <footer class="border-t border-slate-200 bg-white py-6">
      <div class="mx-auto w-full max-w-screen-2xl px-4 sm:px-6">
        <div
          class="flex flex-col gap-3 text-xs text-slate-500 sm:flex-row sm:items-center sm:justify-between"
        >
          <div class="flex items-start gap-3">
            <img src="/logo.svg" alt="" class="mt-0.5 h-5 w-5 shrink-0" aria-hidden="true" />
            <div class="flex flex-col gap-1">
              <p class="font-medium text-slate-700">
                &copy; 2025 Tricentis Testim ユーザー制作日本語翻訳ドキュメント
              </p>
              <p class="text-slate-400">
                このサイトは <a
                  href="https://help.testim.io/docs/testim-overview"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-blue-600 underline decoration-blue-200 hover:text-blue-700"
                >
                  Tricentis Testim Docs（公式ドキュメント）
                </a> のユーザー制作日本語翻訳ドキュメントです
              </p>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <a
              href="https://status.tricentis.com/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Tricentis ステータスページ（新しいタブで開く）"
              class="text-slate-400 transition hover:text-slate-600"
            >
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M18.364 5.636a9 9 0 010 12.728M15.536 8.464a5 5 0 010 7.072M12 12h.01" />
              </svg>
            </a>
            <a
              href="https://github.com/rymetry/testim-docs-ja"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="GitHub リポジトリ（新しいタブで開く）"
              class="text-slate-400 transition hover:text-slate-600"
            >
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
              </svg>
            </a>
            <a
              href="https://x.com/rymetry"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="X（旧 Twitter）（新しいタブで開く）"
              class="text-slate-400 transition hover:text-slate-600"
            >
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const KEY = 'doc-sidebar-scroll';
        const getEl = () => document.getElementById('doc-sidebar-scroll');

        const restore = () => {
          const el = getEl();
          if (!el) return;
          try {
            const saved = sessionStorage.getItem(KEY);
            if (!saved) return;
            const { top } = JSON.parse(saved);
            if (typeof top === 'number') el.scrollTop = top;
          } catch {}
        };

        const save = () => {
          const el = getEl();
          if (!el) return;
          try {
            sessionStorage.setItem(KEY, JSON.stringify({ top: el.scrollTop }));
          } catch {}
        };

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', restore, { once: true });
        } else {
          restore();
        }

        window.addEventListener('beforeunload', save);
        window.addEventListener('pagehide', save);
      })();
    </script>

    <script is:inline>
      (() => {
        const isImageLink = (img) => img.closest('a');

        const backdrop = document.createElement('div');
        backdrop.className = 'image-lightbox-backdrop';

        const body = document.createElement('div');
        body.className = 'image-lightbox-body';

        const closeBtn = document.createElement('button');
        closeBtn.type = 'button';
        closeBtn.className = 'image-lightbox-close';
        closeBtn.setAttribute('aria-label', '閉じる');
        closeBtn.innerText = '×';

        const img = document.createElement('img');
        img.alt = '';
        const caption = document.createElement('div');
        caption.className = 'image-lightbox-caption';

        body.appendChild(closeBtn);
        body.appendChild(img);
        body.appendChild(caption);
        backdrop.appendChild(body);
        document.body.appendChild(backdrop);

        const hide = () => {
          backdrop.classList.remove('is-visible');
          img.src = '';
          caption.textContent = '';
        };

        const show = (src, altText) => {
          img.src = src;
          img.alt = altText || '';
          caption.textContent = altText || '';
          backdrop.classList.add('is-visible');
        };

        backdrop.addEventListener('click', (e) => {
          if (e.target === backdrop || e.target === closeBtn) {
            hide();
          }
        });

        window.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') hide();
        });

        document.addEventListener('click', (e) => {
          const target = e.target;
          if (!(target instanceof HTMLImageElement)) return;
          if (!target.closest('.docs-prose')) return;
          if (isImageLink(target)) return;

          const src = target.currentSrc || target.src;
          if (!src) return;

          e.preventDefault();
          show(src, target.alt || '');
        });
      })();
    </script>
  </body>
</html>
