---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import NavSidebar from '../components/navigation/NavSidebar.astro';
import TableOfContents from '../components/TableOfContents.astro';
import SearchModal from '../components/SearchModal';
import SidebarScrollRestore from '../components/SidebarScrollRestore.astro';
import ImageLightbox from '../components/ImageLightbox.astro';
import type { NavItem } from '../types/navigation';

type DocsLayoutProps = {
  title: string;
  description: string;
  hero?: {
    eyebrow?: string;
    title: string;
    subtitle: string;
    primaryCta?: { label: string; href: string };
    secondaryCta?: { label: string; href: string };
  };
  navSections: NavItem[];
  currentSlug: string;
  headings: MarkdownHeading[];
  sourceUrl?: string;
};

const { title, description, hero, navSections, currentSlug, headings, sourceUrl } =
  Astro.props as DocsLayoutProps;
---

<BaseLayout title={title} description={description}>
  <SiteHeader sticky>
    <div class="flex w-full flex-col gap-2 sm:w-auto sm:min-w-[280px]">
      <SearchModal client:load />
      <div class="lg:hidden" id="mobile-doc-nav-container">
        <div class="relative">
          <select
            id="mobile-doc-nav"
            aria-label="カテゴリナビゲーション"
            class="w-full appearance-none rounded-xl border-2 border-slate-200 bg-white px-4 py-3 text-sm font-medium text-slate-700 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-200"
            onchange="if (this.value) window.location.href=this.value"
          >
            {
              navSections.map((section) => (
                <optgroup label={section.label}>
                  {section.items.map((item) => (
                    <option value={`/docs/${item.slug}`} selected={item.slug === currentSlug}>
                      {item.title}
                    </option>
                  ))}
                </optgroup>
              ))
            }
          </select>
          <svg
            class="pointer-events-none absolute right-4 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 9l-7 7-7-7"></path>
          </svg>
        </div>
      </div>
    </div>
  </SiteHeader>

  <div class="mx-auto flex w-full max-w-screen-2xl flex-1 gap-8 px-4 py-10 sm:px-6 lg:gap-12">
    <aside class="hidden w-64 shrink-0 lg:block">
      <div
        id="doc-sidebar-scroll"
        class="sticky top-30 max-h-[calc(100vh-7rem)] overflow-y-auto pr-2"
      >
        <NavSidebar sections={navSections} currentSlug={currentSlug} />
      </div>
    </aside>

    <main class="flex-1 min-w-0">
      {
        hero ? (
          <section class="rounded-3xl bg-linear-to-br from-blue-600 via-blue-500 to-sky-400 p-8 text-white shadow-lg">
            <p class="text-xs uppercase tracking-[0.4em] text-blue-100">{hero.eyebrow}</p>
            <h1 class="mt-3 text-3xl font-semibold leading-tight">{hero.title}</h1>
            <p class="mt-4 max-w-2xl text-base text-blue-50">{hero.subtitle}</p>
            <div class="mt-6 flex flex-wrap gap-3 text-sm">
              {hero.primaryCta && (
                <a
                  href={hero.primaryCta.href}
                  class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 font-semibold text-blue-600 shadow-sm transition hover:-translate-y-0.5 hover:shadow-lg"
                >
                  {hero.primaryCta.label}
                </a>
              )}
              {hero.secondaryCta && (
                <a
                  href={hero.secondaryCta.href}
                  class="inline-flex items-center gap-2 rounded-full border border-white/60 px-4 py-2 font-semibold text-white transition hover:bg-white/10"
                >
                  {hero.secondaryCta.label}
                </a>
              )}
            </div>
          </section>
        ) : (
          <h1 class="text-3xl font-semibold">{title}</h1>
        )
      }

      {sourceUrl && (
        <a
          href={sourceUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-3 inline-flex items-center gap-1 text-xs text-slate-500 transition hover:text-blue-600"
        >
          Testim Docs
          <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3" />
          </svg>
        </a>
      )}

      <article class="docs-prose mt-10 max-w-none text-base leading-relaxed">
        <slot />
      </article>
    </main>

    <aside class="hidden w-60 shrink-0 xl:block">
      <TableOfContents headings={headings} />
    </aside>
  </div>

  <SiteFooter />
  <SidebarScrollRestore />
  <ImageLightbox />
</BaseLayout>
