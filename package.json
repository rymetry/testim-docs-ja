{
  "name": "testim-docs-ja",
  "description": "Testim 公式ヘルプドキュメントの日本語ローカライゼーション",
  "type": "module",
  "version": "0.0.1",
  "license": "MIT",
  "author": "rymetry",
  "homepage": "https://github.com/rymetry/testim-docs-ja#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rymetry/testim-docs-ja.git"
  },
  "bugs": {
    "url": "https://github.com/rymetry/testim-docs-ja/issues"
  },
  "engines": {
    "node": ">=18 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "npm run lint:md && npm run lint:docs",
    "lint:md": "npm run lint:md:content && npm run lint:md:repo",
    "lint:md:content": "markdownlint 'src/content/docs/**/*.md' --config .markdownlint-docs.json",
    "lint:md:repo": "markdownlint 'docs/**/*.md' 'scripts/**/*.md' '.github/**/*.md' '*.md' --config .markdownlint.json",
    "lint:fix": "markdownlint 'src/content/docs/**/*.md' --config .markdownlint-docs.json --fix && markdownlint 'docs/**/*.md' 'scripts/**/*.md' '.github/**/*.md' '*.md' --config .markdownlint.json --fix",
    "test": "node --test scripts/__tests__/*.mjs",
    "lint:docs": "node scripts/lint-docs.mjs",
    "format": "prettier --write \"**/*.{astro,ts,js,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{astro,ts,js,json,css,md}\"",
    "docs:sync-sidebar": "node scripts/update_sidebar_urls_from_live.mjs",
    "docs:sync-frontmatter": "node scripts/sync_frontmatter_from_sidebar.mjs",
    "docs:sync-frontmatter:apply": "node scripts/sync_frontmatter_from_sidebar.mjs --apply",
    "docs:pipeline": "node scripts/pipeline.mjs",
    "docs:pipeline:full": "node scripts/pipeline.mjs --mode=full",
    "docs:pipeline:diff": "node scripts/pipeline.mjs --mode=diff",
    "docs:fetch": "node scripts/fetch_translate_images.mjs",
    "docs:fix-alt": "node scripts/fix_alt_all.mjs",
    "docs:normalize": "node scripts/normalize_docs.mjs",
    "docs:placeholders": "node scripts/generate_untranslated_placeholders.mjs",
    "docs:prepare-llm": "node scripts/prepare_llm_tasks.mjs",
    "docs:apply-llm": "node scripts/apply_llm_translations.mjs",
    "docs:report-categories": "node scripts/report_frontmatter_categories.mjs",
    "check:parity": "node scripts/check_source_parity.mjs",
    "check:summary": "node scripts/generate_detection_reports.mjs",
    "check:snapshots:fetch": "node scripts/snapshot_update.mjs",
    "check:snapshots:diff": "node scripts/snapshot_diff.mjs",
    "check:snapshots": "node scripts/snapshot_update.mjs && node scripts/snapshot_diff.mjs",
    "check:snapshots:fetch:dry-run": "node scripts/snapshot_update.mjs --dry-run",
    "generate:url-mapping": "node scripts/generate_url_mapping.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^5.0.1",
    "@astrojs/sitemap": "^3.7.1",
    "@astrojs/vercel": "^10.0.1",
    "@microflash/remark-callout-directives": "^5.0.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.16",
    "astro": "^6.0.6",
    "dotenv": "^17.2.3",
    "gray-matter": "^4.0.3",
    "hastscript": "^9.0.1",
    "minisearch": "^7.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.16"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "markdownlint-cli": "^0.48.0",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "rehype-autolink-headings": "^7.1.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.7.3",
    "unist-util-visit": "^5.0.0"
  }
}
