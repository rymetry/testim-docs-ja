{
  "name": "testim-docs-ja",
  "description": "Testim 公式ヘルプドキュメントの日本語ローカライゼーション",
  "type": "module",
  "version": "0.0.1",
  "license": "MIT",
  "author": "rymetry",
  "homepage": "https://github.com/rymetry/testim-docs-ja#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rymetry/testim-docs-ja.git"
  },
  "bugs": {
    "url": "https://github.com/rymetry/testim-docs-ja/issues"
  },
  "engines": {
    "node": ">=18 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "npm run lint:md && npm run lint:docs",
    "lint:md": "npm run lint:md:content && npm run lint:md:repo",
    "lint:md:content": "markdownlint 'src/content/docs/**/*.md' --config .markdownlint-docs.json",
    "lint:md:repo": "markdownlint 'docs/**/*.md' 'scripts/**/*.md' '.github/**/*.md' '*.md' --config .markdownlint.json",
    "lint:fix": "markdownlint 'src/content/docs/**/*.md' --config .markdownlint-docs.json --fix && markdownlint 'docs/**/*.md' 'scripts/**/*.md' '.github/**/*.md' '*.md' --config .markdownlint.json --fix",
    "test": "node --test scripts/__tests__/*.mjs",
    "test:mjs": "node --test scripts/__tests__/*.mjs",
    "test:py": "cd scripts/py && uv run pytest",
    "test:py:cov": "cd scripts/py && uv run pytest --cov=testim_parity --cov-report=term-missing",
    "test:py:quick": "cd scripts/py && uv run pytest -m 'not corpus and not slow and not cutover and not parity_smoke and not recall and not boundary'",
    "test:py:slow": "cd scripts/py && uv run pytest -m slow",
    "test:py:corpus": "cd scripts/py && node tools/emit_corpus_oracle.mjs --out .corpus_expected.jsonl --suite segments_en,turndown && TESTIM_CORPUS_EXPECTED_JSONL=\"$PWD/.corpus_expected.jsonl\" uv run pytest -m corpus -n auto --dist load --tb=short",
    "test:py:parity-smoke": "cd scripts/py && uv run pytest -m 'parity_smoke and not cutover' --tb=short",
    "test:py:quality": "cd scripts/py && uv run pytest -m 'recall or boundary' --tb=short --durations=30",
    "test:py:cutover": "cd scripts/py && uv run pytest -o addopts= -m cutover",
    "test:py:full": "cd scripts/py && uv run pytest -m 'not cutover'",
    "test:quick": "npm run test:mjs && npm run test:py:quick",
    "test:all": "npm run test:mjs && npm run test:py:full",
    "lint:docs": "node scripts/tools/lint_docs.mjs",
    "check:untranslated": "node scripts/detection/find_untranslated.mjs",
    "lint:glossary": "node scripts/tools/check_glossary_duplicates.mjs",
    "format": "prettier --write \"**/*.{astro,ts,js,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{astro,ts,js,json,css,md}\"",
    "docs:sync-sidebar": "node scripts/pipeline/update_sidebar_urls_from_live.mjs",
    "docs:sync-frontmatter": "node scripts/tools/sync_frontmatter_from_sidebar.mjs",
    "docs:sync-frontmatter:apply": "node scripts/tools/sync_frontmatter_from_sidebar.mjs --apply",
    "docs:pipeline": "node scripts/pipeline/pipeline.mjs",
    "docs:pipeline:full": "node scripts/pipeline/pipeline.mjs --mode=full",
    "docs:pipeline:diff": "node scripts/pipeline/pipeline.mjs --mode=diff",
    "docs:fetch": "node scripts/pipeline/fetch_translate_images.mjs",
    "docs:fix-alt": "node scripts/tools/fix_alt_all.mjs",
    "docs:normalize": "node scripts/tools/normalize_docs.mjs",
    "docs:placeholders": "node scripts/pipeline/generate_untranslated_placeholders.mjs",
    "docs:prepare-llm": "node scripts/pipeline/prepare_llm_tasks.mjs",
    "docs:apply-llm": "node scripts/pipeline/apply_llm_translations.mjs",
    "docs:report-categories": "node scripts/tools/report_frontmatter_categories.mjs",
    "check:parity": "node scripts/detection/check_source_parity.mjs",
    "check:patch-review": "node scripts/detection/check_patch_review_cadence.mjs",
    "check:upstream-recovery": "node scripts/detection/check_upstream_recovery.mjs",
    "check:summary": "node scripts/detection/generate_detection_reports.mjs",
    "generate:parity-baseline": "node scripts/detection/generate_parity_baseline.mjs",
    "check:snapshots:fetch": "node scripts/detection/snapshot_update.mjs",
    "check:snapshots:diff": "node scripts/detection/snapshot_diff.mjs",
    "check:snapshots": "node scripts/detection/snapshot_update.mjs && node scripts/detection/snapshot_diff.mjs",
    "check:snapshots:fetch:dry-run": "node scripts/detection/snapshot_update.mjs --dry-run",
    "regen:py-patches": "node scripts/py/tools/regen_en_source_patches.mjs",
    "check:py-patches": "node scripts/py/tools/regen_en_source_patches.mjs --check"
  },
  "dependencies": {
    "@astrojs/react": "^5.0.1",
    "@astrojs/sitemap": "^3.7.1",
    "@astrojs/vercel": "^10.0.2",
    "@microflash/remark-callout-directives": "^5.0.0",
    "@tailwindcss/vite": "^4.1.16",
    "astro": "^6.1.8",
    "dotenv": "^17.2.3",
    "gray-matter": "^4.0.3",
    "minisearch": "^7.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.16"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "markdownlint-cli": "^0.48.0",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "rehype-autolink-headings": "^7.1.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "turndown": "^7.2.2",
    "typescript": "^5.7.3",
    "unist-util-visit": "^5.0.0"
  }
}
